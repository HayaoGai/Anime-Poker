{
  "compilerOptions": {
    "target": "ES2023",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "paths": {
      "@shared/*": ["../shared/src/*"]
    }
  },
  // 測試會載入客戶端的純邏輯模組（如 RoomSession），需要客戶端的 Colyseus 全域型別
  "include": ["src", "test", "*.config.ts", "../client/types/colyseus.d.ts"]
}
