{
  "name": "@anime-poker/server",
  "private": true,
  "type": "module",
  "main": "dist/index.mjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node build.mjs",
    "start": "node --enable-source-maps dist/index.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p ../shared/tsconfig.json"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.21",
    "@colyseus/schema": "^5.0.42",
    "@colyseus/ws-transport": "^0.18.4",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
